---
// Reads public/media/<slug>/manifest.json at build time and renders a grid of
// MediaItem. Falls back to a single placeholder if no manifest exists. Includes
// a tiny vanilla-JS lightbox island (only wired to real images, not placeholders).
import { promises as fs } from 'node:fs';
import path from 'node:path';
import MediaItem, { type MediaType } from './MediaItem.astro';

interface Props { slug: string; title?: string; }
const { slug, title = 'What it looks like' } = Astro.props;

let items: { file: string; caption?: string; type?: MediaType; width?: number; height?: number }[] = [];
try {
  const p = path.resolve(process.cwd(), 'public', 'media', slug, 'manifest.json');
  const manifest = JSON.parse(await fs.readFile(p, 'utf8'));
  items = Array.isArray(manifest.items) ? manifest.items : [];
} catch {
  items = [{ file: 'shot-01.png', caption: 'Add a screenshot or GIF', type: 'placeholder' }];
}

const hasReal = items.some((i) => i.type && i.type !== 'placeholder');
---
<section class="gallery" aria-label={title}>
  <div class="gallery__head">
    <h2>{title}</h2>
    {!hasReal && (
      <p class="gallery__note faint">
        Screens and recordings for this project are being added.
      </p>
    )}
  </div>
  <div class="gallery__grid">
    {items.map((it) => (
      <MediaItem slug={slug} file={it.file} caption={it.caption} type={it.type}
                 width={it.width} height={it.height} />
    ))}
  </div>
</section>

{hasReal && (
  <dialog id="lightbox" class="lightbox">
    <button class="lightbox__close" aria-label="Close">✕</button>
    <img class="lightbox__img" src="" alt="" />
  </dialog>
  <script is:inline>
    (function () {
      var dlg = document.getElementById('lightbox');
      if (!dlg) return;
      var img = dlg.querySelector('.lightbox__img');
      document.querySelectorAll('[data-lightbox]').forEach(function (el) {
        el.addEventListener('click', function () {
          var inner = el.querySelector('img');
          img.src = el.getAttribute('data-lightbox');
          img.alt = (inner && inner.getAttribute('alt')) || '';
          if (typeof dlg.showModal === 'function') dlg.showModal();
        });
      });
      function close() { dlg.close(); img.src = ''; }
      dlg.querySelector('.lightbox__close').addEventListener('click', close);
      dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); });
    })();
  </script>
)}

<style>
  .gallery__head { margin-bottom: 1rem; }
  .gallery__head h2 { margin: 0; }
  .gallery__note { font-size: .85rem; margin: .3rem 0 0; }
  .gallery__grid {
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .lightbox {
    border: none; background: transparent; max-width: 92vw; max-height: 92vh; padding: 0;
  }
  .lightbox::backdrop { background: rgba(0,0,0,.82); backdrop-filter: blur(2px); }
  .lightbox__img { max-width: 92vw; max-height: 88vh; border-radius: 10px; display: block; }
  .lightbox__close {
    position: fixed; top: 4vh; right: 5vw; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid #fff5; background: #000a; color: #fff; font-size: 1.1rem; cursor: pointer;
  }
</style>
