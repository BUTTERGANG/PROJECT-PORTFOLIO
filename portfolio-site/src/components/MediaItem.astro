---
// Renders one media asset. Type is chosen by manifest `type` or file extension:
//   image (.png/.jpg/.webp) → <img loading=lazy>
//   gif   (.gif)            → <img>
//   video (.mp4/.webm)      → <video autoplay muted loop playsinline>  (GIF-like, tiny)
//   placeholder             → neutral "Preview" box carrying the caption
//
// A media file is considered "present" only when type != 'placeholder'. Until
// real assets are dropped in and the manifest updated, every item renders as a
// neutral preview box so the layout is complete.

export type MediaType = 'image' | 'gif' | 'video' | 'placeholder';

interface Props {
  slug: string;
  file: string;
  caption?: string;
  type?: MediaType;
  width?: number;
  height?: number;
}
const { slug, file, caption = '', type, width, height } = Astro.props;

const ext = file.split('.').pop()?.toLowerCase() ?? '';
const inferred =
  type ??
  (['mp4', 'webm'].includes(ext) ? 'video'
    : ext === 'gif' ? 'gif'
    : ['png', 'jpg', 'jpeg', 'webp', 'avif'].includes(ext) ? 'image'
    : 'placeholder');

const src = `/media/${slug}/${file}`;
const isVideo = inferred === 'video';
const isImg = inferred === 'image' || inferred === 'gif';
const isPlaceholder = inferred === 'placeholder';

// Intrinsic dimensions (from the manifest) let the browser reserve the exact
// box before the asset loads → zero layout shift. `aspect-ratio` is the belt-
// and-suspenders fallback the width/height attrs already imply.
const dims = width && height ? { width, height } : {};
const ar = width && height ? `${width} / ${height}` : undefined;
---
<figure class="media">
  {isVideo && (
    <video class="media__el" src={src} autoplay muted loop playsinline preload="metadata"
           style={ar && `aspect-ratio:${ar}`} {...dims} aria-label={caption}></video>
  )}
  {isImg && (
    <button type="button" class="media__btn" data-lightbox={src}
            aria-label={caption ? `Enlarge: ${caption}` : 'Enlarge image'}>
      <img class="media__el media__el--clickable" src={src} alt={caption}
           style={ar && `aspect-ratio:${ar}`} {...dims}
           loading="lazy" decoding="async" />
    </button>
  )}
  {isPlaceholder && (
    <div class="media__ph" role="img" aria-label={caption ? `Preview: ${caption}` : 'Preview coming soon'}>
      <span class="media__ph-badge">Preview</span>
      <p class="media__ph-cap">{caption || 'Screen recording coming soon'}</p>
    </div>
  )}
  {caption && !isPlaceholder && <figcaption class="media__cap">{caption}</figcaption>}
</figure>

<style>
  .media { margin: 0; }
  .media__el {
    width: 100%; height: auto; display: block;
    border-radius: var(--radius-sm); border: 1px solid var(--border);
    background: var(--bg-inset);
  }
  .media__btn {
    display: block; width: 100%; padding: 0; border: 0; background: none;
    cursor: zoom-in; border-radius: var(--radius-sm);
  }
  .media__el--clickable { cursor: zoom-in; }
  .media__cap { font-size: .82rem; color: var(--text-dim); margin-top: .5rem; }

  .media__ph {
    border: 1.5px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    background:
      repeating-linear-gradient(-45deg, transparent, transparent 9px,
        color-mix(in srgb, var(--accent) 6%, transparent) 9px,
        color-mix(in srgb, var(--accent) 6%, transparent) 18px),
      var(--bg-inset);
    padding: 1.4rem; min-height: 150px;
    display: flex; flex-direction: column; gap: .55rem; justify-content: center;
  }
  .media__ph-badge {
    align-self: flex-start; font-family: var(--font-mono); font-size: .7rem; font-weight: 700;
    color: var(--accent-label); letter-spacing: .08em; text-transform: uppercase;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-soft); padding: .2em .6em; border-radius: 999px;
  }
  .media__ph-cap { margin: 0; color: var(--text-dim); font-size: .92rem; line-height: 1.45; overflow-wrap: anywhere; }
</style>
