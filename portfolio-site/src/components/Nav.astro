---
// Nav order = the narrative arc, NOT alphabetical.
const links = [
  { href: '/live-execution/', label: 'Live Execution' },
  { href: '/builder/',        label: 'Builder' },
  { href: '/business/',       label: 'Business' },
  { href: '/next-chapter/',   label: 'Next Chapter' },
  { href: '/contact/',        label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__brand">
      <span class="nav__brand-mark" aria-hidden="true"></span>
      Alex&nbsp;Butterfield
    </a>

    <div class="nav__actions">
      <button id="theme-toggle" class="nav__theme" type="button" aria-label="Toggle color theme">
        <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2.5v2.5M12 19v2.5M4.4 4.4l1.8 1.8M17.8 17.8l1.8 1.8M2.5 12H5M19 12h2.5M4.4 19.6l1.8-1.8M17.8 6.2l1.8-1.8"></path>
        </svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
        </svg>
      </button>

      <button class="nav__toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Open navigation menu">
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
      </button>
    </div>

    <div class="nav__panel" id="nav-panel">
      <nav class="nav__links" aria-label="Primary" id="nav-links">
        <span class="nav__indicator" aria-hidden="true"></span>
        {links.map((l, i) => (
          <a href={l.href}
             class:list={['nav__link', { 'is-active': isActive(l.href) }]}
             style={`--i:${i}`}>
            {l.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow .3s ease, border-color .3s ease;
  }
  .nav.is-scrolled { box-shadow: var(--shadow); border-bottom-color: var(--border-strong); }

  @media (prefers-reduced-motion: no-preference) {
    html.js .nav { animation: nav-in .5s cubic-bezier(.2,.7,.2,1) both; }
  }
  @keyframes nav-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

  .nav__inner {
    display: flex; align-items: center; flex-wrap: wrap; gap: .5rem 1rem;
    min-height: 60px; transition: min-height .25s ease;
  }
  .nav.is-scrolled .nav__inner { min-height: 52px; }

  /* ── Brand ─────────────────────────────────────────────────────────────── */
  .nav__brand {
    order: 1; display: inline-flex; align-items: center; gap: .5em;
    font-weight: 700; letter-spacing: -.01em; color: var(--text); font-size: 1rem;
    flex: none;
  }
  .nav__brand:hover { text-decoration: none; color: var(--accent-text); }
  .nav__brand-mark {
    width: 7px; height: 7px; border-radius: 2px; background: var(--accent);
    transition: transform .4s cubic-bezier(.2,.7,.2,1), border-radius .4s ease;
  }
  .nav__brand:hover .nav__brand-mark { transform: rotate(90deg); border-radius: 50%; }

  /* ── Links + sliding indicator ────────────────────────────────────────── */
  .nav__panel { order: 2; margin-left: auto; }
  .nav__links { position: relative; display: flex; gap: .1rem; }
  .nav__link {
    position: relative; z-index: 1;
    font-size: .9rem; color: var(--text-dim); padding: .35em .7em; border-radius: 8px;
    transition: color .15s ease, background-color .15s ease;
  }
  .nav__link:hover, .nav__link:focus-visible { color: var(--text); background: var(--bg-inset); text-decoration: none; }
  .nav__link.is-active { color: var(--accent-text); }

  .nav__indicator {
    position: absolute; left: 0; top: 0; width: 0; height: 0; opacity: 0;
    border-radius: 8px; background: var(--bg-inset); border: 1px solid var(--border);
    pointer-events: none; z-index: 0;
    transition: transform .3s cubic-bezier(.2,.7,.2,1), width .3s cubic-bezier(.2,.7,.2,1),
                height .2s ease, opacity .2s ease;
  }

  /* ── Actions (theme toggle + hamburger) ───────────────────────────────── */
  .nav__actions { order: 3; display: flex; align-items: center; gap: .5rem; flex: none; }

  .nav__theme {
    position: relative; overflow: hidden;
    background: var(--bg-inset); border: 1px solid var(--border); color: var(--text-dim);
    border-radius: 8px; width: 34px; height: 34px; cursor: pointer; flex: none;
    transition: color .15s ease, border-color .15s ease;
  }
  .nav__theme:hover { color: var(--accent-text); border-color: var(--accent); }
  .nav__theme .icon {
    position: absolute; inset: 0; margin: auto; width: 17px; height: 17px;
    transition: opacity .3s ease, transform .4s cubic-bezier(.2,.7,.2,1);
  }
  .nav__theme .icon-sun { opacity: 0; transform: rotate(-90deg) scale(.4); }
  .nav__theme .icon-moon { opacity: 1; transform: rotate(0) scale(1); }
  :root[data-theme="light"] .nav__theme .icon-sun { opacity: 1; transform: rotate(0) scale(1); }
  :root[data-theme="light"] .nav__theme .icon-moon { opacity: 0; transform: rotate(90deg) scale(.4); }

  .nav__toggle {
    display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px;
    width: 34px; height: 34px; background: var(--bg-inset); border: 1px solid var(--border);
    border-radius: 8px; cursor: pointer; flex: none;
  }
  .nav__toggle:hover { border-color: var(--accent); }
  .nav__toggle-bar {
    width: 16px; height: 2px; background: var(--text-dim); border-radius: 1px;
    transition: transform .3s cubic-bezier(.2,.7,.2,1), opacity .2s ease, background-color .2s ease;
  }
  .nav__toggle:hover .nav__toggle-bar { background: var(--accent-text); }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(2) { opacity: 0; }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile: links collapse into an animated dropdown panel ─────────────
     Without JS, `.nav__panel` never gets the grid collapse rules below, so
     it just renders as a normal block — links stay visible and reachable. */
  @media (max-width: 680px) {
    .nav__actions { order: 2; margin-left: auto; }
    .nav__panel { order: 3; width: 100%; margin-left: 0; }
    .nav__toggle { display: flex; }
    .nav__links { flex-direction: column; align-items: stretch; gap: .15rem; padding-block: .6rem .9rem; }
    .nav__indicator { display: none; }
    .nav__link { padding: .6em .5em; }

    html.js .nav__panel {
      display: grid; grid-template-rows: 0fr; overflow: hidden;
      transition: grid-template-rows .35s cubic-bezier(.2,.7,.2,1);
    }
    html.js .nav__panel > .nav__links { min-height: 0; overflow: hidden; }
    html.js .nav__panel.is-open { grid-template-rows: 1fr; }

    @media (prefers-reduced-motion: no-preference) {
      html.js .nav__link {
        opacity: 0; transform: translateX(-8px);
        transition: opacity .3s ease, transform .3s cubic-bezier(.2,.7,.2,1);
        transition-delay: calc(var(--i, 0) * 45ms);
      }
      html.js .nav__panel.is-open .nav__link { opacity: 1; transform: none; }
    }
  }
</style>

<script is:inline>
  (function () {
    var header = document.getElementById('site-nav');
    var toggle = document.getElementById('nav-toggle');
    var panel = document.getElementById('nav-panel');
    var linksNav = document.getElementById('nav-links');
    var indicator = linksNav ? linksNav.querySelector('.nav__indicator') : null;
    var links = linksNav ? Array.prototype.slice.call(linksNav.querySelectorAll('.nav__link')) : [];
    var themeBtn = document.getElementById('theme-toggle');

    // ---- Theme toggle ----
    function themeLabel() {
      var dark = document.documentElement.getAttribute('data-theme') !== 'light';
      return 'Switch to ' + (dark ? 'light' : 'dark') + ' theme';
    }
    if (themeBtn) {
      themeBtn.setAttribute('aria-label', themeLabel());
      themeBtn.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        themeBtn.setAttribute('aria-label', themeLabel());
      });
    }

    // ---- Mobile menu ----
    function closeMenu() {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      panel.classList.remove('is-open');
    }
    function openMenu() {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation menu');
      panel.classList.add('is-open');
    }
    if (toggle && panel && header) {
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        if (open) closeMenu(); else openMenu();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          toggle.focus();
        }
      });
      document.addEventListener('click', function (e) {
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        if (header.contains(e.target)) return;
        closeMenu();
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 680) closeMenu();
      });
      links.forEach(function (a) { a.addEventListener('click', closeMenu); });
    }

    // ---- Sliding "magic line" indicator (desktop hover/focus) ----
    function place(el) {
      if (!indicator) return;
      if (!el) { indicator.style.opacity = '0'; return; }
      var r = el.getBoundingClientRect();
      var pr = linksNav.getBoundingClientRect();
      indicator.style.width = r.width + 'px';
      indicator.style.height = r.height + 'px';
      indicator.style.transform = 'translateX(' + (r.left - pr.left) + 'px) translateY(' + (r.top - pr.top) + 'px)';
      indicator.style.opacity = '1';
    }
    function restIndicator() {
      place(linksNav.querySelector('.nav__link.is-active'));
    }
    if (indicator && links.length) {
      links.forEach(function (a) {
        a.addEventListener('mouseenter', function () { place(a); });
        a.addEventListener('focus', function () { place(a); });
      });
      linksNav.addEventListener('mouseleave', restIndicator);
      linksNav.addEventListener('focusout', function (e) {
        if (!linksNav.contains(e.relatedTarget)) restIndicator();
      });
      requestAnimationFrame(restIndicator);
      window.addEventListener('resize', restIndicator);
    }

    // ---- Scroll-compact header ----
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
