---
// Nav order = the narrative arc, NOT alphabetical.
const links = [
  { href: '/live-execution/', label: 'Live Execution' },
  { href: '/builder/',        label: 'Builder' },
  { href: '/business/',       label: 'Business' },
  { href: '/next-chapter/',   label: 'Next Chapter' },
  { href: '/contact/',        label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__brand">Alex&nbsp;Butterfield</a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav__link', { 'is-active': isActive(l.href) }]}>{l.label}</a>
      ))}
    </nav>
    <button id="theme-toggle" class="nav__theme" type="button" aria-label="Toggle color theme">
      <span aria-hidden="true">◐</span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner { display: flex; align-items: center; gap: 1rem; height: 58px; }
  .nav__brand { font-weight: 700; letter-spacing: -.01em; color: var(--text); font-size: 1rem; }
  .nav__brand:hover { text-decoration: none; color: var(--accent-text); }
  .nav__links { display: flex; gap: .35rem; margin-left: auto; flex-wrap: wrap; }
  .nav__link {
    font-size: .9rem; color: var(--text-dim); padding: .35em .7em; border-radius: 8px;
  }
  .nav__link:hover { color: var(--text); background: var(--bg-inset); text-decoration: none; }
  .nav__link.is-active { color: var(--accent-text); }
  .nav__theme {
    background: var(--bg-inset); border: 1px solid var(--border); color: var(--text-dim);
    border-radius: 8px; width: 34px; height: 34px; cursor: pointer; font-size: 1rem; flex: none;
  }
  .nav__theme:hover { color: var(--accent-text); border-color: var(--accent); }
  @media (max-width: 620px) {
    .nav__brand { font-size: .92rem; }
    .nav__links { gap: .1rem; }
    .nav__link { padding: .3em .5em; font-size: .82rem; }
  }
  @media (max-width: 440px) {
    /* Let nav grow to two rows instead of overflowing: brand + toggle on top,
       links wrap onto their own line. */
    .nav__inner { height: auto; flex-wrap: wrap; padding-block: .5rem; row-gap: .3rem; }
    .nav__links { order: 3; width: 100%; margin-left: 0; justify-content: space-between; }
    .nav__theme { margin-left: auto; }
    .nav__link { padding: .3em .4em; font-size: .78rem; }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>
