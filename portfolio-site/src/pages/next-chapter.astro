---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chips from '../components/Chips.astro';
import MediaGallery from '../components/MediaGallery.astro';
import { pillarByKey } from '../data/pillars';
import { allProjects, extractOneLiner } from '../lib/projects';

const pillar = pillarByKey('next')!;
const projects = await allProjects();
const jobHunter = projects.find((p) => p.id === 'job-hunter');
const oneLiner = jobHunter ? extractOneLiner(jobHunter.body) : null;
---
<BaseLayout title={`${pillar.label} — Alex Butterfield`} description={pillar.tagline}>
  <section class="phead">
    <div class="wrap-narrow">
      <p class="eyebrow">Pillar 0{pillar.num}</p>
      <h1>{pillar.label}</h1>
      <p class="lede">{pillar.tagline}</p>
      <p class="muted">
        The whole portfolio makes one argument: when something's in my way, I build the tool that
        removes it — {projects.length}+ shipped projects, entirely self-taught. The next chapter is
        doing that as the job itself, not something built around the edges of one.
      </p>
    </div>
  </section>

  {jobHunter && (
    <section class="proof reveal">
      <div class="wrap-narrow">
        <p class="eyebrow">And here’s the proof I mean it</p>
        <h2>I built the tool for this job search.</h2>
        {oneLiner && <p class="lede">{oneLiner}</p>}
        <Chips data={jobHunter.data} />
        <div class="proof__gallery">
          <MediaGallery slug={jobHunter.id} title="Job Hunter — what it looks like" />
        </div>
        <p>
          The same instinct that turns a wedding into a paperwork PWA and a lift into a competition
          simulator turned “I need a better job” into a system. That’s what you’d be hiring.
        </p>
        <a class="btn btn--accent" href={`/projects/${jobHunter.id}/`}>Read the full case study →</a>
      </div>
    </section>
  )}

  <section class="looking">
    <div class="wrap-narrow prose">
      <h2>What I’m looking for</h2>
      <p>
        Software and technical builder roles — full-stack, automation-heavy, or AI-integration work
        especially. I’m self-taught and shipped, not credentialed: {projects.length}+ live projects
        across Next.js/React, Python automation, Postgres/SQLite pipelines, Playwright-driven scraping,
        and Claude/AI integrations — each one built because I hit a real problem and refused to
        work around it by hand.
      </p>
      <p>
        This isn’t a career pivot so much as a change in what I get paid for. The
        <a href="/live-execution/">execution track record</a> — running high-throughput operations at
        <strong>Amazon</strong> (teams of 25–50, ~25,000 packages/day), holding
        <strong>R2 V3 compliance</strong> on a returns-and-repair line, coordinating
        <strong>3 simultaneous events</strong> with sub-15-minute room flips — is what taught me to
        ship under pressure and learn fast. The next chapter just puts that instinct on the tools
        full-time instead of around the edges of a day job.
      </p>
      <h2>Resume</h2>
      <p class="muted">
        📄 I tailor a resume to the specific role rather than shipping one generic PDF.
        <a href="/contact/">Get in touch</a> and I’ll send the version that fits the seat.
      </p>
      <p class="next"><a href="/contact/">Get in touch →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .phead { padding-block: 3rem 1rem; border-bottom: 1px solid var(--border); }
  .proof { padding-block: 2.5rem; background: var(--bg-raised); border-bottom: 1px solid var(--border); }
  .proof .chips { margin: 1rem 0; }
  .proof__gallery { margin: 1.5rem 0; }
  .looking { padding-block: 2rem 3rem; }
  .next { margin-top: 2rem; font-weight: 600; }
</style>
