---
// /photography/ — the LA Media photo/video portfolio, folded into the personal
// site. Two audiences on purpose: clients who want to book a shoot (CTA to
// workwithla.media) and hiring managers who want to see the creative work that
// the LA Media tooling was built to run.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PHOTO_CATEGORIES, VIDEO_OFFERING } from '../data/photography';
import { projectsByCluster } from '../lib/projects';

const photoProjects = await projectsByCluster('photo');
const photoCount = PHOTO_CATEGORIES.reduce((n, c) => n + c.photos.length + (c.hero ? 1 : 0), 0);
const BOOK = 'https://workwithla.media';

const packages = [
  {
    discipline: 'Weddings',
    rows: [
      { tier: 'The Ceremony',  price: '$1,800', hours: '4 hours coverage',  inc: '300+ edited photos' },
      { tier: 'The Full Day',  price: '$2,800', hours: '8 hours coverage',  inc: '500+ edited photos + highlight film' },
      { tier: 'The Legacy',    price: '$4,200', hours: 'Full day coverage', inc: '700+ edited photos + full film + 60s reel' },
    ],
    note: 'Every wedding package includes an online gallery, full-resolution downloads and a print release.',
  },
  {
    discipline: 'Portraits',
    rows: [
      { tier: 'The Essentials', price: '$300', hours: '30 min session', inc: 'Online gallery + downloads' },
      { tier: 'The Signature',  price: '$450', hours: '1 hour session', inc: 'Online gallery + downloads' },
      { tier: 'The Legacy',     price: '$600', hours: '2 hour session', inc: 'Online gallery + downloads' },
    ],
    note: 'Add-ons available per session — second location, extra looks, prints.',
  },
  {
    discipline: 'Sports & meets',
    rows: [
      { tier: 'Bronze', price: 'Contact', hours: '40+ edited photos',   inc: 'Expedited delivery available' },
      { tier: 'Silver', price: 'Contact', hours: '40+ edited photos',   inc: '+ video of 2 best lifts' },
      { tier: 'Gold',   price: 'Contact', hours: '40+ edited photos',   inc: '+ video of all 6 lifts & 45–60s hype reel' },
    ],
    note: 'Priced per meet, per lifter. Commercial product/brand work is quoted per scope.',
  },
];
---

<BaseLayout
  title="Photography & Video — Alex Butterfield"
  description="The LA Media photo and video portfolio: portraits, sports and powerlifting, weddings and travel — plus the films and reels cut alongside them. Shot by Alex Butterfield in Indianapolis."
  ogImage="/photography/weddings/hero.webp"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero__media">
      <img src="/photography/weddings/hero.webp" alt="Outdoor wedding photographed at golden hour"
           width="1800" height="1200" fetchpriority="high" decoding="async" />
      <div class="phero__scrim" aria-hidden="true"></div>
      <div class="phero__glow" aria-hidden="true"></div>
    </div>
    <div class="wrap phero__body">
      <p class="eyebrow">LA Media · Photography &amp; Video</p>
      <h1 class="phero__h1">I shoot the moments I know how to read.</h1>
      <p class="lede phero__lede">
        {photoCount} frames from the working portfolio — weddings, portraits, lifters, and the road in between.
        Photography is the job that started all of this; the software came later, because running a photo
        business well turns out to be an operations problem.
      </p>
      <p class="phero__note faint">
        Available for weddings, portrait sessions, meet coverage and commercial product/brand work in
        Indianapolis and Central Indiana.
      </p>
      <div class="phero__cta">
        <a class="btn btn--accent" href={BOOK} target="_blank" rel="noopener">Book a shoot →</a>
        <a class="btn" href="#packages">See packages &amp; pricing</a>
      </div>
    </div>
  </section>

  <!-- ── Numbers that are actually true ───────────────────────────────────── -->
  <section class="band">
    <div class="wrap">
      <ul class="stat-band reveal-group">
        <li class="stat" style="--i:0"><span class="stat__num">250+</span><span class="stat__label">edited photos per wedding</span></li>
        <li class="stat" style="--i:1"><span class="stat__num">4–10h</span><span class="stat__label">typical wedding coverage</span></li>
        <li class="stat" style="--i:2"><span class="stat__num">8–12wk</span><span class="stat__label">wedding film turnaround</span></li>
        <li class="stat" style="--i:3"><span class="stat__num">1</span><span class="stat__label">shooter, shoot to delivery</span></li>
      </ul>
    </div>
  </section>

  <!-- ── Gallery carousel ───────────────────────────────────────────────────
       One cover photo per discipline, in a strip you can swipe or click.
       Selecting a cover drops that discipline's gallery in below it. The strip
       is a real scroll container (native swipe/trackpad, plus pointer-drag for
       a mouse) with a tablist on top for keyboard and screen readers — so it
       degrades to "all four galleries stacked" with JS off. -->
  <section class="reel reveal" aria-labelledby="reel-title">
    <div class="wrap">
      <div class="reel__head">
        <h2 id="reel-title">Four disciplines, one cover each</h2>
        <p class="muted reel__hint">
          Swipe the strip, click a cover, or use ← → — the gallery opens underneath it.
        </p>
      </div>

      <div class="reel__viewport" data-reel-viewport>
        <ul class="reel__strip" role="tablist" aria-label="Photography disciplines">
          {PHOTO_CATEGORIES.map((cat, i) => (
            <li class="reel__item">
              <button type="button" role="tab"
                      class:list={['reel__card', { 'is-active': i === 0 }]}
                      id={cat.key}
                      data-cat={cat.key}
                      aria-controls={`panel-${cat.key}`}
                      aria-selected={i === 0 ? 'true' : 'false'}
                      tabindex={i === 0 ? 0 : -1}>
                <img class="reel__img" src={cat.cover?.src} alt="" draggable="false"
                     width={cat.cover?.w} height={cat.cover?.h}
                     loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                <span class="reel__scrim" aria-hidden="true"></span>
                <span class="reel__meta">
                  <span class="reel__label">{cat.label}</span>
                  <span class="reel__count">{cat.photos.length + (cat.cover ? 1 : 0)} photos</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="reel__controls">
        <button type="button" class="reel__arrow" data-reel="prev" aria-label="Previous discipline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>

        <ol class="reel__dots">
          {PHOTO_CATEGORIES.map((cat, i) => (
            <li>
              <button type="button" class:list={['reel__dot', { 'is-active': i === 0 }]}
                      data-cat={cat.key} aria-label={`Show ${cat.label}`}></button>
            </li>
          ))}
        </ol>

        <button type="button" class="reel__arrow" data-reel="next" aria-label="Next discipline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ── The gallery that drops in ──────────────────────────────────────────
       All four panels ship in the HTML; with `html.js` set, only the active one
       renders, so no-JS visitors get every gallery stacked. -->
  <div class="wrap">
    <div class="reel__panels" id="reel-panels">
      {PHOTO_CATEGORIES.map((cat, ci) => (
        <section class="panel" id={`panel-${cat.key}`} role="tabpanel"
                 aria-labelledby={cat.key} tabindex="0"
                 data-cat={cat.key}
                 data-active={ci === 0 ? 'true' : undefined}>
          <header class="panel__head">
            <h2 class="panel__label">{cat.label}</h2>
            <p class="panel__blurb muted">{cat.blurb}</p>
          </header>

          {cat.cover && (
            <figure class="panel__banner">
              <button type="button" class="shot" data-lightbox={cat.cover.src} aria-label={`Enlarge: ${cat.cover.alt}`}>
                <img src={cat.cover.src} alt={cat.cover.alt} width={cat.cover.w} height={cat.cover.h}
                     loading="lazy" decoding="async" />
              </button>
            </figure>
          )}

          <div class="masonry">
            {cat.photos.map((p) => (
              <figure class="shot-wrap">
                <button type="button" class="shot" data-lightbox={p.src} aria-label={`Enlarge: ${p.alt}`}>
                  <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
                </button>
              </figure>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <!-- ── Video ────────────────────────────────────────────────────────────── -->
  <section class="video" id="video">
    <div class="wrap">
      <div class="video__head">
        <h2>Video &amp; film</h2>
        <p class="muted">
          Stills and motion are shot together, not bolted on afterwards — the same coverage day produces
          the gallery and the cut.
        </p>
      </div>
      <div class="grid grid--cards reveal-group">
        {VIDEO_OFFERING.map((v, i) => (
          <article class="card vid" style={`--i:${i}`}>
            <h3>{v.title}</h3>
            <p class="muted">{v.detail}</p>
            <ul class="chips">
              {v.tags.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Packages ─────────────────────────────────────────────────────────── -->
  <section class="packages" id="packages">
    <div class="wrap">
      <div class="packages__head">
        <h2>Packages &amp; pricing</h2>
        <p class="muted">
          Published menu, not “DM me for a quote”. Every shoot is delivered through an online gallery
          clients log in to download from.
        </p>
      </div>
      <div class="grid grid--cards reveal-group">
        {packages.map((p, i) => (
          <article class="card pkg" style={`--i:${i}`}>
            <h3>{p.discipline}</h3>
            <ul class="pkg__rows">
              {p.rows.map((r) => (
                <li>
                  <span class="pkg__tier">{r.tier}</span>
                  <span class="pkg__price">{r.price}</span>
                  <span class="pkg__hours muted">{r.hours}</span>
                  <span class="pkg__inc faint">{r.inc}</span>
                </li>
              ))}
            </ul>
            <p class="pkg__note faint">{p.note}</p>
          </article>
        ))}
      </div>
      <p class="packages__cta">
        Full menu, availability and booking live on the studio site →
        <a href={BOOK} target="_blank" rel="noopener">workwithla.media</a>
      </p>
    </div>
  </section>

  <!-- ── The bridge to the software ───────────────────────────────────────── -->
  <section class="bridge">
    <div class="wrap">
      <div class="bridge__intro prose">
        <h2>Why a photography page is on a software portfolio</h2>
        <p>
          Because this is where the Build Loop started. Running LA Media — quoting, booking, collecting,
          delivering galleries, chasing renewals before they expire — was repetitive enough that I built
          the software to run it. The photo business is the origin story for the tooling, not a separate
          hobby next to it.
        </p>
        <p class="faint">
          If you’re reading this as a hiring manager: the work below is the same instinct you’ll find in
          <a href="/builder/">the case studies</a> — find the friction, then build the fix.
        </p>
      </div>
      <div class="grid grid--cards">
        {photoProjects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- ── Close ────────────────────────────────────────────────────────────── -->
  <section class="close">
    <div class="wrap-narrow close__inner">
      <h2>Want your own set of these?</h2>
      <p class="muted">
        Weddings, portraits, meet coverage, product and brand work — booking through the studio.
      </p>
      <div class="close__cta">
        <a class="btn btn--accent" href={BOOK} target="_blank" rel="noopener">workwithla.media →</a>
        <a class="btn" href="mailto:alex@workwithla.media">alex@workwithla.media</a>
      </div>
    </div>
  </section>

  <!-- Lightbox: native <dialog>, same pattern as the project media galleries.
       Deliberately no src attribute — an <img src=""> resolves to the page URL
       and fires a spurious window error event on every load. The script adds
       the src when a photo opens and removes it again on close. -->
  <dialog id="lightbox" class="lightbox" aria-label="Enlarged photo">
    <button class="lightbox__close" type="button" aria-label="Close">✕</button>
    <img class="lightbox__img" alt="" />
  </dialog>

  <script is:inline>
    /* ---- Carousel: select a cover, drop its gallery in below --------------- */
    /* Wrapped in try/catch on purpose. `html.js` (set pre-paint in BaseLayout)
       is what hides the inactive panels, so if this script ever fails on a
       browser we don't control, the page must fall back to rendering every
       gallery stacked rather than leaving three disciplines unreachable. */
    try {
    (function () {
      var strip = document.querySelector('.reel__strip');
      var holder = document.getElementById('reel-panels');
      if (!strip || !holder) return;

      var cards = [].slice.call(strip.querySelectorAll('.reel__card'));
      var panels = [].slice.call(holder.querySelectorAll('.panel[data-cat]'));
      var dots = [].slice.call(document.querySelectorAll('.reel__dot'));
      var arrows = [].slice.call(document.querySelectorAll('.reel__arrow'));
      var viewport = document.querySelector('[data-reel-viewport]');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!cards.length) return;

      function byCat(list, cat) {
        for (var i = 0; i < list.length; i++) {
          if (list[i].getAttribute('data-cat') === cat) return list[i];
        }
        return null;
      }
      function catOf(el) { return el && el.getAttribute('data-cat'); }
      function current() {
        for (var i = 0; i < cards.length; i++) {
          if (cards[i].classList.contains('is-active')) return catOf(cards[i]);
        }
        return catOf(cards[0]);
      }
      function indexOf(cat) {
        for (var i = 0; i < cards.length; i++) if (catOf(cards[i]) === cat) return i;
        return 0;
      }

      function select(cat, opts) {
        opts = opts || {};
        if (!cat || (!opts.force && cat === current())) return;

        // Measure before the swap so the container can ease between the two
        // heights instead of snapping.
        var fromH = holder.getBoundingClientRect().height;

        for (var i = 0; i < panels.length; i++) {
          if (catOf(panels[i]) === cat) panels[i].setAttribute('data-active', 'true');
          else panels[i].removeAttribute('data-active');
        }
        for (var j = 0; j < cards.length; j++) {
          var on = catOf(cards[j]) === cat;
          cards[j].classList.toggle('is-active', on);
          cards[j].setAttribute('aria-selected', on ? 'true' : 'false');
          cards[j].tabIndex = on ? 0 : -1;
        }
        for (var k = 0; k < dots.length; k++) {
          dots[k].classList.toggle('is-active', catOf(dots[k]) === cat);
        }

        var toH = holder.getBoundingClientRect().height;
        if (!reduce && holder.animate && fromH && toH && Math.abs(fromH - toH) > 1) {
          holder.style.overflow = 'hidden';
          var a = holder.animate(
            [{ height: fromH + 'px' }, { height: toH + 'px' }],
            { duration: 440, easing: 'cubic-bezier(.2,.7,.2,1)' }
          );
          a.onfinish = function () { holder.style.overflow = ''; holder.style.height = ''; };
        }

        // Centre the newly selected cover in the strip.
        var card = byCat(cards, cat);
        if (card && viewport && !opts.noScroll) {
          var want = card.offsetLeft - (viewport.clientWidth - card.offsetWidth) / 2;
          viewport.scrollTo({ left: Math.max(0, want), behavior: reduce ? 'auto' : 'smooth' });
        }
      }

      cards.forEach(function (c) {
        c.addEventListener('click', function () { select(catOf(c)); });
      });
      dots.forEach(function (d) {
        d.addEventListener('click', function () { select(catOf(d)); });
      });
      arrows.forEach(function (b) {
        b.addEventListener('click', function () {
          var dir = b.getAttribute('data-reel') === 'next' ? 1 : -1;
          var next = cards[(indexOf(current()) + dir + cards.length) % cards.length];
          select(catOf(next));
          next.focus();
        });
      });

      // Roving arrow-key navigation across the tabs.
      strip.addEventListener('keydown', function (e) {
        var dir = e.key === 'ArrowRight' ? 1 : (e.key === 'ArrowLeft' ? -1 : 0);
        if (!dir) return;
        e.preventDefault();
        var next = cards[(indexOf(current()) + dir + cards.length) % cards.length];
        select(catOf(next));
        next.focus();
      });

      // Pointer-drag for a mouse. Touch/trackpad already scroll the strip
      // natively, so they're left alone.
      if (viewport) {
        var down = false, moved = 0, startX = 0, startLeft = 0;

        viewport.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'touch') return;
          down = true; moved = 0; startX = e.clientX; startLeft = viewport.scrollLeft;
          // Capture the pointer for the whole gesture. Without this the browser
          // fires pointerleave as soon as the content shifts under the cursor and
          // the drag dies after a few pixels — which is exactly what happened
          // before capture was added.
          if (viewport.setPointerCapture) {
            try { viewport.setPointerCapture(e.pointerId); } catch (err) {}
          }
        });

        viewport.addEventListener('pointermove', function (e) {
          if (!down) return;
          moved = e.clientX - startX;
          if (Math.abs(moved) > 6) {
            e.preventDefault();
            viewport.classList.add('is-dragging');
            viewport.scrollLeft = startLeft - moved;
          }
        });

        function endDrag(e) {
          if (!down) return;
          down = false;
          viewport.classList.remove('is-dragging');
          if (e && viewport.releasePointerCapture && e.pointerId != null) {
            try { viewport.releasePointerCapture(e.pointerId); } catch (err) {}
          }
          if (Math.abs(moved) > 6) {
            // Swallow the click that trails a real drag so it can't also select.
            viewport.addEventListener('click', function once(ev) {
              ev.preventDefault(); ev.stopPropagation();
              viewport.removeEventListener('click', once, true);
            }, true);
          }
        }

        viewport.addEventListener('pointerup', endDrag);
        viewport.addEventListener('pointercancel', endDrag);
      }

      // Deep links: /photography/#portraits should open that discipline.
      function fromHash() {
        var id = decodeURIComponent((location.hash || '').replace(/^#/, ''));
        if (id && byCat(panels, id)) select(id);
      }
      fromHash();
      window.addEventListener('hashchange', fromHash);
    })();
    } catch (err) {
      if (window.console && console.warn) {
        console.warn('[photography] carousel init failed — showing all galleries stacked:', err);
      }
      document.documentElement.classList.remove('js');
    }

    /* ---- Lightbox: native <dialog>, same pattern as the project galleries --- */
    (function () {
      var dlg = document.getElementById('lightbox');
      if (!dlg) return;
      var img = dlg.querySelector('.lightbox__img');
      var shots = document.querySelectorAll('[data-lightbox]');

      function open(el) {
        var inner = el.querySelector('img');
        img.src = el.getAttribute('data-lightbox');
        img.alt = (inner && inner.getAttribute('alt')) || '';
        if (typeof dlg.showModal === 'function') dlg.showModal();
        else dlg.setAttribute('open', '');
      }
      function close() {
        if (dlg.open) dlg.close();
        img.removeAttribute('src');
      }

      shots.forEach(function (el) {
        el.addEventListener('click', function () { open(el); });
      });
      dlg.querySelector('.lightbox__close').addEventListener('click', close);
      dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); });
      dlg.addEventListener('close', function () { img.removeAttribute('src'); });
    })();
  </script>
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .phero { position: relative; padding-block: 0; min-height: min(72svh, 620px); display: flex; align-items: flex-end; }
  .phero__media { position: absolute; inset: 0; overflow: hidden; }
  .phero__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .phero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--bg) 72%, transparent) 0%,
      color-mix(in srgb, var(--bg) 45%, transparent) 45%,
      color-mix(in srgb, var(--bg) 96%, transparent) 100%);
  }
  .phero__glow {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(60% 45% at 50% 100%, var(--accent-soft) 0%, transparent 70%);
  }
  .phero__body { position: relative; padding-block: clamp(2.5rem, 7vw, 4rem); }
  .phero__h1 { max-width: 20ch; margin-bottom: .4em; }
  .phero__lede { max-width: 60ch; margin-bottom: .6rem; }
  .phero__note { max-width: 60ch; font-size: .9rem; }
  .phero__cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }

  /* ── Band ──────────────────────────────────────────────────────────────── */
  .band { padding-block: clamp(2rem, 5vw, 3rem) 0; }

  /* ── Carousel of covers ─────────────────────────────────────────────────
     A real horizontal scroll container (native swipe/trackpad, plus a
     pointer-drag handler for a mouse) with one cover per discipline. The
     active card lifts, warms and gets a sweep of accent light when selected;
     the gallery for it drops in below. */
  .reel { border-top: 1px solid var(--border); padding-block: clamp(2rem, 5vw, 3rem) 0; }
  .reel__head { margin-bottom: 1.2rem; }
  .reel__head h2 { margin-bottom: .3em; }
  .reel__hint { margin: 0; max-width: 62ch; font-size: .95rem; }

  .reel__viewport {
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x proximity;
    /* vertical padding gives the lifted cards room so nothing is clipped */
    padding-block: .7rem 1rem;
    cursor: grab;
    scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent;
  }
  .reel__viewport.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .reel__viewport::-webkit-scrollbar { height: 6px; }
  .reel__viewport::-webkit-scrollbar-track { background: transparent; }
  .reel__viewport::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 99px; }

  .reel__strip { display: flex; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  /* Sized so ~3.2 covers show at desktop width: the strip genuinely overflows,
     so it reads as a carousel instead of four cards that happen to fit. */
  .reel__item { flex: 0 0 clamp(200px, 30vw, 320px); scroll-snap-align: center; }

  .reel__card {
    position: relative; display: block; width: 100%; aspect-ratio: 4 / 5;
    padding: 0; overflow: hidden; cursor: pointer;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-inset);
    /* The card is a drag surface, not a text/image selection target: without
       this a mouse drag over the photo starts a native image drag instead of
       scrolling the strip. */
    user-select: none; -webkit-user-select: none;
    opacity: .68; transform: scale(.965);
    transition: opacity .45s ease, transform .45s cubic-bezier(.2,.7,.2,1),
                border-color .3s ease, box-shadow .35s ease;
  }
  .reel__card img { -webkit-user-drag: none; user-drag: none; }
  .reel__card.is-active {
    opacity: 1; transform: translateY(-4px) scale(1);
    border-color: var(--accent);
    box-shadow: 0 12px 34px rgba(0,0,0,.42);
  }
  :root[data-theme="light"] .reel__card.is-active { box-shadow: 0 10px 26px rgba(0,0,0,.16); }

  .reel__img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: saturate(.8) brightness(.82);
    transform: scale(1.05);
    transition: filter .4s ease, transform .7s cubic-bezier(.2,.7,.2,1);
  }
