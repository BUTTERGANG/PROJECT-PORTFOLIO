modules = ["nodejs-24", "web"]

run = "cd portfolio-site && npm run dev -- --host 0.0.0.0 --port 5000"

[nix]
channel = "stable-25_05"
packages = ["unpackerr"]

[agent]
expertMode = true

[[ports]]
localPort = 3999
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

# ── Static Deployment ────────────────────────────────────────────────
# In the Replit Deployments pane choose "Static", then set:
#   Build command:    cd portfolio-site && npm install && npm run build
#   Public directory: portfolio-site/dist
[deployment]
deploymentTarget = "static"
publicDir = "portfolio-site/dist"
build = ["sh", "-c", "cd portfolio-site && npm install && npm run build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd portfolio-site && npm run dev -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[env]
CLAUDE_CONFIG_DIR = "/home/runner/workspace/.local/state/claude"
